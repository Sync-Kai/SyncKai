{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "2.1.0",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "notifications",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "*://*.crunchyroll.com/*",
    "https://graphql.anilist.co/*",
    "https://myanimelist.net/*",
    "https://api.myanimelist.net/*"
  ],
  "optional_host_permissions": [
    "*://*.netflix.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://s4.anilist.co https://cdn.myanimelist.net https://api-cdn.myanimelist.net"
  },
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.crunchyroll.com/*",
        "*://animationdigitalnetwork.com/*",
        "*://*.animationdigitalnetwork.com/*"
      ],
      "js": [
        "src/content/content.ts"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "<dynamic_resource>"
      ],
      "matches": [
        "*://*.netflix.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "commands": {
    "complete-episode": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdCompleteEpisode__"
    }
  }
}
