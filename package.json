{
  "name": "synckai",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "tsc --noEmit -p scripts && node scripts/generate-icons.ts",
    "package": "tsc --noEmit -p scripts && npm run build && node scripts/package.ts",
    "screenshots": "tsc --noEmit -p scripts/screenshots && node scripts/screenshots/capture.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.0",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
